# Copy to .env and fill in. The app auto-loads .env at startup.

# --- MotherDuck (cloud) ---
# When set, the app connects to MotherDuck: md:<MD_DATABASE>
MOTHERDUCK_TOKEN=
MD_DATABASE=refund_tracker

# --- Local fallback (used only when MOTHERDUCK_TOKEN is empty) ---
# REFUND_DB_PATH=D:\LiteX\Refund_Tracker\refund_tracker.duckdb
