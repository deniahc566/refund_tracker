# Copy to .env and fill in. The app auto-loads .env at startup.

# --- MotherDuck (cloud) ---
# When set, the app connects to MotherDuck: md:<MD_DATABASE>
MOTHERDUCK_TOKEN=
MD_DATABASE=refund_tracker

# --- Local fallback (used only when MOTHERDUCK_TOKEN is empty) ---
# REFUND_DB_PATH=D:\LiteX\Refund_Tracker\refund_tracker.duckdb

# --- Gmail auto-import (python -m refund_tracker.gmail_import) ---
# Gmail that receives the BIDV statements + a Google App Password
# (Google Account → Security → 2-Step Verification → App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Password that opens the BIDV .xlsx attachment (DDMMYYYY issuance date).
STATEMENT_PASSWORD=
# STATEMENT_SENDER=insaoke@bidv.com.vn
# GMAIL_LOOKBACK_DAYS=3
